{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/tauri/capabilities/schema.json",
  "identifier": "default",
  "description": "Default capabilities for the terminal app",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen"
  ]
}
