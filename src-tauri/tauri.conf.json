{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "FigyTerm",
  "version": "0.1.0",
  "identifier": "com.code4mk.figyterm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FigyTerm",
        "width": 1100,
        "height": 700,
        "minWidth": 500,
        "minHeight": 350,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/figyterm.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwODU2QUE3RkFCRkI0M0MKUldROHRMLzZwMnFGSU9PTEhUdk02Z3BJRE5zQzc2dGZCSnpDV0NZR2JnZjNUMzRScGo4UHJtekgK",
      "endpoints": [
        "https://github.com/code4mk/figyterm/releases/latest/download/latest.json"
      ]
    }
  }
}
